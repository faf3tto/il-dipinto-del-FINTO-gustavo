ed": 0, "set-angle": false, "stop-on-solids": false, "enabled": true}}, "eff": {}, "parent": null, "flags": null, "children": [], "cflags": {}, "text": {"text": "cari giocatori. vi lascio questo messaggio:\n", "font": "bloodcrow", "size": 26, "color": [1, 1, 1, 1], "ha": "left", "va": "top", "wrap": "word", "lh": 0, "bold": false, "italic": false, "bbcode": true, "iconset": null}}, {"uid": 1505, "type": "StoricTitles", "plugin": "Text", "layer": "Layer 2", "x": 853, "y": 1613, "z": 0, "w": 1018, "h": 170, "d": 0, "ox": 0, "oy": 0, "a": 0, "op": 1, "color": [1, 1, 1, 1], "vis": true, "coll": true, "iv": {}, "beh": {"MoveTo": {"max-speed": 40, "acceleration": 600, "deceleration": 600, "rotate-speed": 0, "set-angle": false, "stop-on-solids": false, "enabled": true}}, "eff": {}, "parent": null, "flags": null, "children": [], "cflags": {}, "text": {"text": "DA QUANDO FACCIO PARTE DI QUESTO MONDO\nLE COSE NON SONO PIù AL LORO POSTO\nIL POTERE DI RAGGIUNGERE QUELLE FRAZIONI\nè LONTANO ANNI MILIONI.\n", "font": "bloodcrow", "size": 25, "color": [1, 1, 1, 1], "ha": "left", "va": "top", "wrap": "word", "lh": 0, "bold": false, "italic": false, "bbcode": true, "iconset": null}}, {"uid": 1506, "type": "StoricTitles", "plugin": "Text", "layer": "Layer 2", "x": 871, "y": 1863, "z": 0, "w": 1018, "h": 175.10908809041678, "d": 0, "ox": 0, "oy": 0, "a": 6.266735422459805, "op": 1, "color": [1, 1, 1, 1], "vis": true, "coll": true, "iv": {}, "beh": {"MoveTo": {"max-speed": 40, "acceleration": 600, "deceleration": 600, "rotate-speed": 0, "set-angle": false, "stop-on-solids": false, "enabled": true}}, "eff": {}, "parent": null, "flags": null, "children": [], "cflags": {}, "text": {"text": "E LA VIA PER RITORNARE DALLA FOLLIA\nSONO TRATTI CHE NON LA SENTO PIù MIA\nHO PERSO TOTALMENTE IL CONTROLLO DELLE COSE\nE SONO BLOCCATO IN QUESTI LOOP AD OGNI DOVE\n", "font": "bloodcrow", "size": 24, "color": [1, 1, 1, 1], "ha": "left", "va": "top", "wrap": "word", "lh": 0, "bold": false, "italic": false, "bbcode": true, "iconset": null}}, {"uid": 1507, "type": "StoricTitles", "plugin": "Text", "layer": "Layer 2", "x": 853, "y": 2090, "z": 0, "w": 1018, "h": 277, "d": 0, "ox": 0, "oy": 0, "a": 6.2463727862380445, "op": 1, "color": [1, 1, 1, 1], "vis": true, "coll": true, "iv": {}, "beh": {"MoveTo": {"max-speed": 40, "acceleration": 600, "deceleration": 600, "rotate-speed": 0, "set-angle": false, "stop-on-solids": false, "enabled": true}}, "eff": {}, "parent": null, "flags": null, "children": [], "cflags": {}, "text": {"text": "IL CICLO è LA MIA MALINCONIA,\nè CIò CHE MI PORTA A QUESTA PURA E DANNATA FOLLIA\nLA MIA MENTE SPRIGIONA QUESTI INTRIGHI\nDI IDEE SCARTATE PERSONE E SUICIDI\nDA ADESSO MI ARRENDO UNA VOLTA PER TUTTE\nPERCHè IL CICLO CONTINUERà A RITORNARE\nPER SEMPRE", "font": "bloodcrow", "size": 25, "color": [1, 1, 1, 1], "ha": "left", "va": "top", "wrap": "word", "lh": 0, "bold": false, "italic": false, "bbcode": true, "iconset": null}}, {"uid": 1508, "type": "StoricTitles", "plugin": "Text", "layer": "Layer 2", "x": 864, "y": 2514, "z": 0, "w": 1018, "h": 180, "d": 0, "ox": 0, "oy": 0, "a": 0.04403505272685451, "op": 1, "color": [1, 1, 1, 1], "vis": true, "coll": true, "iv": {}, "beh": {"MoveTo": {"max-speed": 40, "acceleration": 600, "deceleration": 600, "rotate-speed": 0, "set-angle": false, "stop-on-solids": false, "enabled": true}}, "eff": {}, "parent": null, "flags": null, "children": [], "cflags": {}, "text": {"text": "GRAZIE A TUTTE LE BUONE ANIME CHE HANNO DECISO DI ARRIVARE FINO IN FONDO, MA è QUI PRESENTE SOLO LA FINE DI QUESTO CICLO, PREPARANDO IL PROSSIMO A RICOMINCIARE, ANCORA E ANCORA...", "font": "bloodcrow", "size": 26, "color": [1, 1, 1, 1], "ha": "left", "va": "top", "wrap": "word", "lh": 0, "bold": false, "italic": false, "bbcode": true, "iconset": null}}, {"uid": 1517, "type": "StoricTitles", "plugin": "Text", "layer": "Layer 2", "x": 963, "y": 3055, "z": 0, "w": 839, "h": 68, "d": 0, "ox": 0, "oy": 0, "a": 0, "op": 1, "color": [1, 